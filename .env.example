# Install root used by launchers and service setup.
CARACAL_HOME=/opt/CaracALPlus
# Optional alternate path to this environment file.
CARACAL_ENV_FILE=
# Adventure Land session cookie for the account used by CaracAL+.
AL_SESSION=replace-with-your-adventure-land-session
# Adventure Land CODE API token; leave blank when CODE sync is unused.
AL_CODE_API_TOKEN=
# Optional base URL for the Adventure Land CODE API.
AL_CODE_API_BASE_URL=
# Pull account CODE files on startup when enabled.
AL_CODE_SYNC_ON_START=true
# Optional local export root used by CODE sync.
ADVENTURELAND_CODE_ROOT=
# Optional custom game client base URL.
ADVENTURE_LAND_CLIENT_BASE_URL=
# Authentication username for the protected monitor.
PI_AUTH_USER=caracalplus
# Password hash for monitor authentication; generate with the setup script.
PI_AUTH_PASSWORD_HASH=replace-with-a-generated-password-hash
# Secret used to sign monitor sessions; generate with openssl rand -hex 32.
PI_AUTH_SECRET=replace-with-a-random-64-character-hex-secret
# Name of the monitor session cookie.
PI_AUTH_COOKIE=caracalplus_session
# Optional cookie domain; use localhost for local-only access.
PI_AUTH_COOKIE_DOMAIN=localhost
# Require HTTPS for the monitor cookie in public deployments.
PI_AUTH_SECURE_COOKIE=false
# Lifetime of monitor sessions in seconds.
PI_AUTH_TTL_SECONDS=43200
# Hostname or origin used by the client control panel.
PI_CLIENT_CONTROL_ORIGIN=https://client.example
# Public origin used by the monitor.
PI_MONITOR_ORIGIN=https://monitor.example
# Port for the browser client server.
CLIENT_PORT=8088
# Port for the headless monitor.
PI_MONITOR_PORT=9024
# Port for the maintainer dashboard.
DASHBOARD_PORT=8090
# Optional public bind address; leave blank to use the platform default.
BIND_ADDRESS=
# Optional client version label.
CLIENT_VERSION=local
# Optional dashboard version label.
MAINTAINER_DASHBOARD_VERSION=local
# Optional deployment environment label.
DEPLOY_ENVIRONMENT=local
# Optional monitor environment label.
PI_ENVIRONMENT=local
# Optional host label displayed in the monitor.
PI_HOST_LABEL=CaracALPlus
# Optional Ollama service URL; use a private hostname when needed.
CARACAL_OLLAMA_URL=http://ollama.example:11434
# Ollama model used by the CaracAL+ chat panel.
CARACAL_OLLAMA_MODEL=llama3.1
# Maximum Ollama context size.
CARACAL_OLLAMA_CONTEXT=32768
# Ollama request timeout in milliseconds.
CARACAL_OLLAMA_TIMEOUT_MS=120000
# Optional dashboard activity data path.
DASHBOARD_ACTIVITY_PATH=
# Maximum age of the dashboard snapshot in seconds.
DASHBOARD_SNAPSHOT_STALE_AFTER_SECONDS=120
# Number of attempts for remote source fetches.
REMOTE_FETCH_ATTEMPTS=3
# Delay between remote source fetch attempts in milliseconds.
REMOTE_RETRY_DELAY_MS=1000
# Number of attempts for client updates.
PI_CLIENT_UPDATE_RETRIES=3
# Timeout for a client update in milliseconds.
PI_CLIENT_UPDATE_TIMEOUT_MS=120000
# Optional relay listen hostname.
CARACAL_RELAY_LISTEN_HOST=localhost
# Relay listen port.
CARACAL_RELAY_LISTEN_PORT=18001
# Private network allowed to reach the relay.
CARACAL_RELAY_ALLOWED_NETWORK=replace-with-your-private-network-cidr
# SSH target used for production deployment.
CARACAL_PRODUCTION_SSH_TARGET=caracal@your-host.example
# SSH target used for the Raspberry Pi deployment.
CARACAL_RPI_SSH_TARGET=replace-with-rpi-ip-address
# SSH key path used for deployment.
CARACAL_DEPLOY_SSH_KEY=/path/to/private-ssh-key
# Host address used by the client and dashboard listeners.
CARACAL_BIND_HOST=::

# Private Ollama host used by the restricted relay.
CARACAL_OLLAMA_HOST=ollama.example

# Address used for the outbound SSH tunnel binding.
CARACAL_TUNNEL_BIND_ADDRESS=localhost

# SSH user and hostname for the relay host.
CARACAL_VPS_SSH_TARGET=replace-with-vps-ip-address

# Public monitor base URL used by deployment health checks.
CARACAL_PUBLIC_BASE_URL=https://monitor.example
# Control panel base URL used by deployment health checks.
CARACAL_CONTROL_BASE_URL=https://control.example

# SSH username for the VPS deployment.
CARACAL_VPS_SSH_USER=caracal
# SSH port for the VPS deployment.
CARACAL_VPS_SSH_PORT=22
# Optional SSH client config file path.
CARACAL_SSH_CONFIG=
